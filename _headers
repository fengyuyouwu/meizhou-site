# Cloudflare Pages 缓存策略（只对 Cloudflare 生效，GitHub Pages 不支持 _headers）
# 注意：Pages 会把所有命中规则的同名响应头**拼接**在一起，所以每条路径只能命中一条规则，
#       不要写 `/*` 兜底——默认就是 public, max-age=0, must-revalidate。

/assets/img/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/fonts/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/audio/*
  Cache-Control: public, max-age=604800
